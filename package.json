{
  "name": "codebase-quest",
  "version": "0.0.0",
  "private": true,
  "description": "Every codebase is a world. Go explore. A 2D pixel-art RPG generated from any code repository.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @codebase-quest/game dev",
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "biome check . && node scripts/check-worldgen-rng.ts && tsc --noEmit -p tsconfig.json",
    "format": "biome check --write .",
    "cq": "node apps/cli/src/main.ts",
    "fixtures": "node scripts/build-fixtures.ts",
    "fixtures:pinned": "node scripts/fetch-pinned.ts",
    "labels:sync": "node scripts/sync-labels.ts",
    "license-check": "node scripts/license-check.ts",
    "analyzer:smoke": "node scripts/analyzer-smoke.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "web-tree-sitter": "0.27.1",
    "zod": "4.6.7"
  }
}
