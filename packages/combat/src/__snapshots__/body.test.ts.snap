        "function table(name: string): Row[] {",
        "  let rows = tables.get(name);",
        "  if (!rows) {",
        "    rows = [];",
        "    tables.set(name, rows);",
        "  }",
        "  return rows;",
        "}",
      ],
      "startLine": 6,
