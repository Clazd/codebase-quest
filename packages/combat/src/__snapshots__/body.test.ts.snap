    "code": {
      "lines": [
        "export function computeTaskStatus(task: StatusFields): TaskStatus {",
        "  if (!task.dueDate) return "open";",
        "  if (task.done) {",
        "    if (task.doneAt > task.dueDate)",
        "      return "late";",
        "    return "done";",
        "  }",
        "  const now = Date.now();",
        "  if (now > task.dueDate) return "overdue";",
        "  return "open";",
        "}",
      ],
      "startLine": 6,
    },
