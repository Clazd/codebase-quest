        "  const snapshot = process.env.TASKLY_SNAPSHOT;",
        "  if (snapshot) loadSnapshot(readFileSync(snapshot, "utf8"));",
        "  createApp().listen(port, () => console.log(\`Taskly listening on http://localhost:\${port}\`));",
        "}",
      ],
