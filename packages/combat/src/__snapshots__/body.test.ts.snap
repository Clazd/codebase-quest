    "code": {
      "lines": [
        "export function createOrder(",
        "  customerId: string,",
        "  items: CartItem[],",
        "  address: Address,",
        "  coupon: Coupon | null,",
        "  giftWrap: boolean,",
        "  notes: string[],",
        "  express: boolean,",
        "  month: string,",
        "): Order {",
        "  const order: Order = {",
        "    id: \`order-\${nextOrder}\`,",
        "    customerId,",
        "    month,",
        "    items,",
        "    subtotal: cartTotal(items),",
        "    coupon,",
        "    giftWrap,",
        "    express,",
        "    notes: [...notes, address.name],",
        "  };",
        "  nextOrder += 1;",
        "  return order;",
        "}",
      ],
      "startLine": 7,
    },
