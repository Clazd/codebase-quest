        "export function loadSnapshot(json: string): void {",
        "  try {",
        "    const data = JSON.parse(json) as Record<string, Row[]>;",
        "    for (const [name, rows] of Object.entries(data)) tables.set(name, rows);",
        "  } catch (error) {",
        "  }",
        "}",
