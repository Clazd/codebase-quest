        "export function createTask(input: NewTask): Task {",
        "  const task: Task = {",
        "    id: \`task-\${nextId++}\`,",
        "    title: input.title,",
        "    slug: slugify(input.title),",
        "    teamId: input.teamId,",
        "    ownerId: input.ownerId,",
        "    dueDate: input.dueDate,",
        "    sharedWith: [],",
        "    archived: false,",
        "    done: false,",
        "  };",
        "  return saveTask(task);",
        "}",
      ],
      "startLine": 22,
