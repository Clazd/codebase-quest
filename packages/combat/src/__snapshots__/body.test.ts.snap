      "lines": [
        "export function getTaskHandler(req: Request, res: Response): void {",
        "  const task = getTask(req.params.id);",
        "  if (!task) {",
        "    res.status(404).json({ error: "Task not found" });",
        "    return;",
        "  }",
        "  res.json(present(task));",
        "}",
      ],
      "startLine": 36,
    },
