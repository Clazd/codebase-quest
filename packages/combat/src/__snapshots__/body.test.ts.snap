    "code": {
      "lines": [
        "export function update<T extends Row>(name: string, id: string, patch: Partial<T>): T | undefined {",
        "  const row = table(name).find((r) => r.id === id) as T | undefined;",
        "  if (row) Object.assign(row, patch);",
        "  return row;",
        "}",
      ],
      "startLine": 28,
    },
