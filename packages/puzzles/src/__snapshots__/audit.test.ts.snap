            "export function loadTeam(teamId: string): Team {",
            "  const [team] = query<Team>("teams", { id: teamId });",
            "  if (!team) throw new TeamNotFoundError(\`No team "\${teamId}"\`);",
            "  return team;",
            "}",
          ],
          "startLine": 7,
        },
