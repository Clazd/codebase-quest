            "export function checkPermissions(task: Task, userId: string): void {",
            "  const team = loadTeam(task.teamId);",
            "  if (!team.memberIds.includes(userId)) {",
            "    throw new PermissionError(\`User "\${userId}" is not in team "\${team.name}"\`);",
            "  }",
            "}",
          ],
          "startLine": 13,
