            "export function shareTaskHandler(req: Request, res: Response): void {",
            "  try {",
            "    const task = shareTask(req.params.id, currentUser(req), req.body.userId);",
            "    res.json(present(task));",
            "  } catch (error) {",
            "    res.status(403).json({ error: (error as Error).message });",
            "  }",
            "}",
