        "code": {
          "lines": [
            "export function query<T extends Row>(name: string, where: Partial<T> = {}): T[] {",
            "  const entries = Object.entries(where);",
            "  return (table(name) as T[]).filter((row) =>",
            "    entries.every(([key, value]) => (row as Record<string, unknown>)[key] === value),",
            "  );",
            "}",
          ],
          "startLine": 16,
        },
