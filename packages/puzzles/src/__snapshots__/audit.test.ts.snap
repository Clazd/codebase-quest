        "code": {
          "lines": [
            "export function monthlyRevenue(orders: Order[], month: string): number {",
            "  let total = 0;",
            "  for (const order of orders) {",
            "    if (order.month === month) {",
            "      total += order.subtotal;",
            "    }",
            "  }",
            "  return total;",
            "}",
          ],
          "startLine": 4,
        },
